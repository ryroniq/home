(defcfg
  process-unmapped-keys yes
)

(defvar
  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =
       q    w    e    r    t    y    u    i    o    p    [    ]
  caps a    s    d    f    g    h    j    k    l    ;    '
       z    x    c    v    b    n    m    ,    .    /
                           spc
)

(defalias
  qw  (layer-switch qw)
  ry  (layer-switch ry)
  nav (layer-toggle nav)
  fn  (layer-toggle fn)

  cap (tap-hold-press 200 200 esc lctl)
  spc (tap-hold 200 200 spc (layer-toggle nav))

  lp  (unicode "(")
  rp  (unicode ")")
)

;; Ryroniq (Gallium based kanata layout)
(deflayer ry
  @qw  lsft lctl lalt lmet @nav -    =    @fn  rmet ralt rctl rsft
       j    l    d    c    v    k    f    o    u    q    _    _
  @cap n    r    s    t    g    y    h    a    e    i    _
       ;    x    m    w    z    b    p    ,    .    /
                           @spc
)

;; QWERTY
(deflayer qw
  @ry  lsft lctl lalt lmet @nav -    =    @fn  rmet ralt rctl rsft
       _    _    _    _    _    _    _    _    _    _    _    _
  @cap _    _    _    _    _    _    _    _    _    _    _
       _    _    _    _    _    _    _    _    _    _
                           @spc
)

;; Navigation
(deflayer nav
  esc  lsft lctl lalt lmet @nav -    =    @fn  rmet ralt rctl rsft
       1    2    3    4    5    home pgup pgdn end  ,    @lp  @rp
  @cap 6    7    8    9    0    left down up  right -    =
       kp/  kp*  kp-  kp+  .    bspc del  ins  spc  grv
                           _
)

;; Function keys
(deflayer fn
  esc  lsft lctl lalt lmet @nav -    =    @fn  rmet ralt rctl rsft
       f1   f2   f3   f4   f5   home pgup pgdn end  \    @lp  @rp
  @cap f6   f7   f8   f9   f10  left down up  right -    =
       f11  f12  menu menu menu bspc del  ins  spc  grv
                           _
)
