(defcfg
  process-unmapped-keys yes
)

(defvar
  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(defsrc
       1    2    3    4    5    6    7    8    9    0    -    =
       q    w    e    r    t    y    u    i    o    p
  caps a    s    d    f    g    h    j    k    l    ;    '
       z    x    c    v    b    n    m    ,    .    /
  lctl                     spc            ralt      rctl
)

(defalias
  ls-q1 (layer-switch q1)
  ls-q2 (layer-switch q2)
  ls-ry (layer-switch ry)

  am (tap-hold-release-keys 200 200 a lalt $left-hand-keys)
  sm (tap-hold-release-keys 200 200 s lmet $left-hand-keys)
  lm (tap-hold-release-keys 200 200 l lmet $right-hand-keys)
  ;m (tap-hold-release-keys 200 200 ; lalt $right-hand-keys)
)

(defalias
  cap (tap-hold-press 200 200 esc lctl)
  spc (tap-hold 200 200 spc (layer-toggle nav))

  pls (unicode "+")
  ast (unicode "*")
  lp  (unicode "(")
  rp  (unicode ")")
)

;; QWERTY
(deflayer q1
       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  _    _
       _    _    _    _    _    _    _    _    _    _
  @cap _    _    _    _    _    _    _    _    _    _    _
       _    _    _    _    _    _    _    _    _    _
  @ls-q1                   @spc           @ls-q2    @ls-ry
)

(deflayer q2
       _    _    _    _    _    _    _    _    _    _    _    _
       _    _    _    _    _    _    _    _    _    _
  @cap @am  @sm  _    _    _    _    _    _    @lm  @;m  _
       _    _    _    _    _    _    _    _    _    _
  @ls-q1                   @spc           @ls-q2    @ls-ry
)

;; Ryroniq (Gallium based kanata layout)
(deflayer ry
       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  _    _
       j    l    d    c    v    k    f    o    u    q
  @cap n    r    s    t    g    y    h    a    e    i    _
       ;    x    m    w    z    b    p    ,    .    /
  @ls-q1                   @spc           @ls-q2    @ls-ry
)

;; Navigation
(deflayer nav
       -    7    8    9    /    menu rmet ralt rctl rsft f11  f12
       @pls 4    5    6    @ast home pgup pgdn end  \
  @cap 0    1    2    3    .    left down up  right -    =
       @lp  @rp  =    ,    spc  bspc del  ins  spc  grv
  XX                       _              XX        XX
)
