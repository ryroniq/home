alias a=alias
alias b=bindkey
alias c=clear
alias d=date
alias f=fg
alias g='grep --color=always'
alias h=history
alias i=id
alias j=jobs
alias l=less
alias m=mpv
alias p=pwd
alias s=ssh
alias t=tmux
alias v=vim

alias ls='ls --color=auto'
alias ll='ls --color=always -l'
alias la='ls --color=always -la'
alias lll='ls --color=always -l | less'
alias ta='tmux attach'
alias rr=rehash

alias mk=make
alias py=python

alias c3='cal -3'
alias ct='column -t'
alias ua='uname -a'
alias rp=realpath

alias sc=systemctl
alias jc=journalctl
alias hn='hostnamectl hostname'
alias bt=bluetoothctl

alias mt=mutt
alias nm=notmuch
alias nmn='notmuch new'
alias nms='notmuch search'

alias pc='pass -c'
alias pe='pass edit'

alias gad='git add'
alias gam='git am'
alias gap='git apply'
alias gb='git branch'
alias gba='git branch -avv'
alias gblm='git blame'
alias gbr='git branch -rvv'
alias gbv='git branch -vv'
alias gcf='git config --list'
alias gcfg='git config --global --list'
alias gcfl='git config --local --list'
alias gcl='git clone'
alias gcm='git commit'
alias gcp='git cherry-pick'
alias gd='git diff'
alias gds='git diff --staged'
alias gft='git fetch'
alias gib='git init --bare'
alias gl='git log'
alias glf='git log --pretty=fuller --stat'
alias glg='git log --oneline --graph --decorate --all'
alias glp='git log -p'
alias gmrg='git merge'
alias gpl='git pull'
alias gps='git push'
alias grb='git rebase'
alias grs='git reset'
alias grl='git reflog'
alias grm='git rm'
alias grt='git remote'
alias grtv='git remote -v'
alias grv='git revert'
alias gsa='git stash'
alias gsh='git show'
alias gst='git status'
alias gsw='git switch'
alias gswc='git switch -c'
alias gtg='git tag'
alias gtr='git restore'
alias gtrs='git restore --staged'

alias gpg-agent-updatetty='gpg-connect-agent updatestartuptty /bye'
alias gpg-agent-reload='gpg-connect-agent reloadagent /bye'
alias gpg-agent-kill='gpg-connect-agent killagent /bye'

alias sa='ssh-add'
alias sad='ssh-add -D'
alias sal='ssh-add -l'

alias trim="tr -d '\n'"
alias show-cursor='printf "\033[?25h"'
